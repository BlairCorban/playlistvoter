# Neon Postgres connection string (Vercel sets this for you when you add the Neon integration)
DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require
# Any long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
